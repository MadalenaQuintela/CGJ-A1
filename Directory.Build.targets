<Project>
	<PropertyGroup>
		<OpenGLLibraries>$(MSBuildThisFileDirectory)libraries\</OpenGLLibraries>
	</PropertyGroup>

	<ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj' And '$(Platform)' == 'x64' And '$(ConfigurationType)' == 'Application'">
		<ClCompile>
			<AdditionalIncludeDirectories>$(OpenGLLibraries)glew\include;$(OpenGLLibraries)glfw\include;$(OpenGLLibraries)glm;$(OpenGLLibraries)assimp\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<AdditionalLibraryDirectories>$(OpenGLLibraries)glfw\lib-vc2026;$(OpenGLLibraries)glew\lib\Release\x64;$(OpenGLLibraries)assimp\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
			<AdditionalDependencies>opengl32.lib;glew32.lib;glfw3dll.lib;assimp-vc145-mt.lib;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>

	<Target Name="CopyOpenGLRuntimeDlls" AfterTargets="Build"
	        Condition="'$(MSBuildProjectExtension)' == '.vcxproj' And '$(Platform)' == 'x64' And '$(ConfigurationType)' == 'Application'">
		<ItemGroup>
			<OpenGLRuntimeDll Include="$(OpenGLLibraries)glew\bin\Release\x64\glew32.dll" />
			<OpenGLRuntimeDll Include="$(OpenGLLibraries)glfw\lib-vc2026\glfw3.dll" />
			<OpenGLRuntimeDll Include="$(OpenGLLibraries)assimp\bin\x64\assimp-vc145-mt.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(OpenGLRuntimeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>